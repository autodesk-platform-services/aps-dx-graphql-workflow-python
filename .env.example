# APS (Autodesk Platform Services) app credentials - create an app at
# https://aps.autodesk.com/myapps with a callback URL matching APS_REDIRECT_URI.
APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_REDIRECT_URI=http://localhost:5000/oauth/callback
# data:read is required for the Hubs node's GetHubs query (Data Exchange API)
APS_SCOPE=user-profile:read data:read

# Signs the session cookie that stores the OAuth state + access token.
FLASK_SECRET_KEY=change-me

# Local dev only — the Docker image sets FLASK_DEBUG=0 and BEHIND_PROXY=1.
PORT=5000
FLASK_DEBUG=1
BEHIND_PROXY=0
SESSION_COOKIE_SECURE=0
